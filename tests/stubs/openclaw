#!/usr/bin/env python3
"""Stub openclaw notify."""

from __future__ import annotations

import os
import sys
from pathlib import Path


def main() -> None:
    jobs = os.environ.get("ONYX_JOBS_DIR")
    message = ""
    if "-m" in sys.argv:
        message = sys.argv[sys.argv.index("-m") + 1]
    if jobs:
        path = Path(jobs) / "openclaw.log"
        with path.open("a") as fh:
            fh.write(message + "\n")
    print("notified")


if __name__ == "__main__":
    main()
